{
  "name": "wasl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.15.1 <11"
  },
  "scripts": {
    "build": "corepack pnpm api:generate && corepack pnpm -r build",
    "dev": "corepack pnpm --parallel --stream dev",
    "lint": "eslint client server shared --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:phase3:integration": "corepack pnpm --filter @wasl/server build && corepack pnpm --filter @wasl/server exec tsx test/phase3.integration.ts",
    "test:participation:postgres": "corepack pnpm --filter @wasl/server exec tsx test/participation-postgres.integration.ts",
    "test:privacy:postgres": "corepack pnpm --filter @wasl/server exec tsx test/privacy.integration.ts",
    "test:organizations:postgres": "corepack pnpm --filter @wasl/server exec tsx test/organizations-postgres.integration.ts",
    "test:discussions:postgres": "corepack pnpm --filter @wasl/server exec tsx test/discussions-postgres.integration.ts && corepack pnpm --filter @wasl/server exec tsx test/discussions-posting.integration.ts",
    "test:messaging:postgres": "corepack pnpm --filter @wasl/server exec tsx test/messaging-postgres.integration.ts",
    "test:messaging:stream": "corepack pnpm --filter @wasl/server exec tsx test/messaging-stream.integration.ts",
    "test:e2e": "corepack pnpm --filter @wasl/web test:e2e",
    "storybook:build": "corepack pnpm --filter @wasl/web storybook:build",
    "api:generate": "corepack pnpm --filter @wasl/server openapi:generate && corepack pnpm --filter @wasl/web api:generate",
    "db:generate": "corepack pnpm --filter @wasl/server db:generate",
    "db:migrate": "corepack pnpm --filter @wasl/server db:migrate",
    "db:seed": "corepack pnpm --filter @wasl/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "eslint": "9.35.0",
    "eslint-import-resolver-typescript": "4.3.5",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.43.0",
    "vitest": "3.2.4"
  }
}
