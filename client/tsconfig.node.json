  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "orval.config.ts",
    "playwright.config.ts",
