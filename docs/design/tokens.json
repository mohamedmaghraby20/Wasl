{
  "meta": {
    "name": "Wasl Design Tokens",
    "version": "1.0.0-preview",
    "note": "Semantic tokens are the contract. The brighter Wasl lime is provisional until the visual preview is reviewed."
  },
  "typography": {
    "family": {
      "ui": "Manrope",
      "arabic": "Tajawal",
      "heading": "var(--font-family-ui)"
    },
    "size": {
      "2xs": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.75rem",
      "4xl": "2.25rem",
      "display": "clamp(2.4rem, 4vw, 3.6rem)"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.12,
      "heading": 1.22,
      "body": 1.55,
      "relaxed": 1.7
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem"
  },
  "shape": {
    "radiusNone": "0",
    "radiusSm": "0.375rem",
    "radiusMd": "0.625rem",
    "radiusLg": "0.875rem",
    "radiusXl": "1.125rem",
    "radius2xl": "1.5rem",
    "radiusPill": "999px",
    "borderWidth": "1px",
    "focusRingWidth": "3px"
  },
  "sizing": {
    "controlSm": "2.25rem",
    "controlMd": "2.75rem",
    "controlLg": "3.125rem",
    "iconSm": "1rem",
    "iconMd": "1.25rem",
    "iconLg": "1.5rem",
    "avatarSm": "1.75rem",
    "avatarMd": "2.25rem",
    "avatarLg": "3rem"
  },
  "layout": {
    "containerMax": "75rem",
    "containerReading": "43rem",
    "sidebarWidth": "15.25rem",
    "breakpoints": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "2xl": "90rem"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "elevation": {
    "xs": "0 1px 2px rgb(20 30 12 / 5%)",
    "sm": "0 2px 6px rgb(20 30 12 / 6%), 0 1px 2px rgb(20 30 12 / 4%)",
    "md": "0 8px 24px rgb(20 30 12 / 8%), 0 2px 6px rgb(20 30 12 / 4%)",
    "lg": "0 18px 42px rgb(20 30 12 / 12%), 0 4px 12px rgb(20 30 12 / 5%)"
  },
